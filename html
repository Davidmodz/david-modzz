<!DOCTYPE html><html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DAVIDLOKS</title>  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #111827;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      text-align: center;
    }

    .contenedor {
      width: 90%;
      max-width: 420px;
    }

    h1 {
      font-size: 38px;
    }

    p {
      color: #bfc5d1;
    }

    .boton {
      display: block;
      padding: 16px;
      margin-top: 18px;
      border-radius: 12px;
      color: white;
      text-decoration: none;
      font-size: 19px;
      font-weight: bold;
      border: none;
      width: 100%;
      box-sizing: border-box;
      cursor: pointer;
    }

    .whatsapp {
      background: #25D366;
    }

    .continuar {
      background: #2563eb;
    }

    .oculto {
      display: none;
    }

    #contador {
      margin-top: 20px;
      font-size: 18px;
      color: #9ca3af;
    }
  </style></head><body>  <div class="contenedor"><h1>DAVIDLOKS</h1>

<p>Únete a nuestro canal de WhatsApp</p>

<a class="boton whatsapp"
   href="https://whatsapp.com/channel/0029Vb9KxEP29756DyrDuc3p"
   target="_blank">
  Seguir canal
</a>

<button class="boton continuar" onclick="iniciar()">
  Continuar
</button>

<div id="contador" class="oculto"></div>

  </div>  <script>
    function iniciar() {
      let segundos = 3;
      const contador = document.getElementById("contador");

      contador.classList.remove("oculto");
      contador.textContent = "Espera " + segundos + " segundos...";

      const intervalo = setInterval(() => {
        segundos--;

        if (segundos > 0) {
          contador.textContent = "Espera " + segundos + " segundos...";
        } else {
          clearInterval(intervalo);
          contador.textContent = "¡Listo!";
        }
      }, 1000);
    }
  </script></body>
</html>